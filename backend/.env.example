# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Use the SAME user + password + database that exist on YOUR machine.
#
# Typical Windows install uses superuser `postgres` + password you chose at install time:
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pearl_safari_db"
#
# If you use Docker Compose from repo root (`docker-compose up`), defaults match pearl_user / pearl_password_123:
#   DATABASE_URL="postgresql://pearl_user:pearl_password_123@localhost:5432/pearl_safari_db"
#
# Create DB + role in psql (if needed):
#   CREATE USER pearl_user WITH PASSWORD 'your_secure_password';
#   CREATE DATABASE pearl_safari_db OWNER pearl_user;
#
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/pearl_safari_db"

# Server
PORT=5000
NODE_ENV=development

# JWT — change in production
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# CORS (comma-separated origins)
FRONTEND_URL="http://localhost:5000,http://localhost:3000,http://127.0.0.1:5000"
