{
    "$schema": "https://railway.app/json-schema/railway.json",
    "build": {
        "builder": "nixpacks",
        "buildCommand": "cd backend && npm install"
    },
    "deploy": {
        "startCommand": "cd backend && npm start",
        "restartPolicyType": "on_failure",
        "restartPolicyMaxRetries": 5,
        "healthchecks": {
            "readiness": {
                "initialDelaySeconds": 10,
                "periodSeconds": 10,
                "timeoutSeconds": 3,
                "failureThreshold": 3,
                "httpGet": {
                    "path": "/api/health",
                    "port": 5000
                }
            }
        }
    }
}